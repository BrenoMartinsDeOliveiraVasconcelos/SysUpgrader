{
    "apt": {
        "path": "/usr/bin/apt-get", 
        "commands": ["update", "upgrade -y"]
    },
    "snapd": {
        "path": "/usr/bin/snap", 
        "commands": ["refresh"]
    },
    "flatpak": {
        "path": "/usr/bin/flatpak", 
        "commands": ["update"]
    },
    "pacman": {
        "path": "/usr/bin/pacman", 
        "commands": ["-Syu"]
    },
    "yay": {
        "path": "/usr/bin/yay", 
        "commands": ["-Syu"]
    }
}